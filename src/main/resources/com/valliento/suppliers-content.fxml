<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.valliento.controller.SuppliersController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search supplier..." onAction="#onSearch" HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox spacing="15" VBox.vgrow="ALWAYS">
        <VBox spacing="10" styleClass="section-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="All Suppliers" />
            <TableView fx:id="suppliersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Supplier Name" prefWidth="180" />
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120" />
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="160" />
                    <TableColumn fx:id="totalPurchaseColumn" text="Total Purchase" prefWidth="120" />
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="80" />
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="section-card" prefWidth="280">
            <Label styleClass="section-title" text="Add / Edit Supplier" />
            <Label text="Select a row to edit, or fill in blank fields to add new." style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" wrapText="true" />

            <VBox spacing="4">
                <Label text="Name" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="nameField" promptText="e.g. ABC Distributors" />
            </VBox>
            <VBox spacing="4">
                <Label text="Phone" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="phoneField" promptText="e.g. 9876543210" />
            </VBox>
            <VBox spacing="4">
                <Label text="Email" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="emailField" promptText="e.g. abc@dis.com" />
            </VBox>

            <HBox spacing="8">
                <Button styleClass="btn-save" text="Add" onAction="#onAddSupplier" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button styleClass="btn-hold" text="Update" onAction="#onUpdateSupplier" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox spacing="8">
                <Button text="Delete" onAction="#onDeleteSupplier" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button text="Clear" onAction="#onClear" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </HBox>
</VBox>