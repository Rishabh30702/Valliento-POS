<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<SplitPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.valliento.controller.ProductsController"
           dividerPositions="0.65">

    <VBox spacing="10" styleClass="section-card">
        <Label styleClass="section-title" text="All Products" />
        <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="180" />
                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120" />
                <TableColumn fx:id="priceColumn" text="Price" prefWidth="90" />
                <TableColumn fx:id="stockColumn" text="Stock" prefWidth="80" />
                <TableColumn fx:id="gstColumn" text="GST" prefWidth="90" />
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="12" styleClass="section-card">
        <Label styleClass="section-title" text="Add / Edit Product" />
        <Label text="Select a row to edit, or fill in blank fields to add new." style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" wrapText="true" />

        <VBox spacing="4">
            <Label text="Name" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="nameField" promptText="e.g. Cappuccino" />
        </VBox>

        <VBox spacing="4">
            <Label text="Category" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="categoryField" promptText="e.g. Beverages" />
        </VBox>

        <VBox spacing="4">
            <Label text="Price (₹)" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="priceField" promptText="e.g. 120.00" />
        </VBox>

        <VBox spacing="4">
            <Label text="Stock" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="stockField" promptText="e.g. 45" />
        </VBox>

        <VBox spacing="4">
            <Label text="GST" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <ComboBox fx:id="gstComboBox" promptText="Select GST rate" maxWidth="Infinity" />
        </VBox>

        <HBox spacing="8">
            <Button styleClass="btn-save" text="Add" onAction="#onAddProduct" />
            <Button styleClass="btn-pay" text="Update" onAction="#onUpdateProduct" />
            <Button styleClass="btn-hold" text="Delete" onAction="#onDeleteProduct" />
            <Button styleClass="category-btn" text="Clear" onAction="#onClearForm" />
        </HBox>
    </VBox>

</SplitPane>