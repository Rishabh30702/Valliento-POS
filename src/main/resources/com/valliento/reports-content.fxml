<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.valliento.controller.ReportsController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <VBox spacing="10" styleClass="section-card">
        <Label styleClass="section-title" text="Sales Report" />

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="From:" />
            <DatePicker fx:id="fromDatePicker" />
            <Label text="To:" />
            <DatePicker fx:id="toDatePicker" />
            <Button styleClass="btn-save" text="Filter" onAction="#onFilter" />
            <Button styleClass="category-btn" text="Export Excel" onAction="#onExportExcel" />
            <Button styleClass="category-btn" text="Export PDF" onAction="#onExportPdf" />
        </HBox>
    </VBox>

    <VBox spacing="10" styleClass="section-card" VBox.vgrow="ALWAYS">
        <TableView fx:id="reportTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="invoiceColumn" text="Invoice No" prefWidth="130" />
                <TableColumn fx:id="cashierColumn" text="Cashier" prefWidth="140" />
                <TableColumn fx:id="shiftColumn" text="Shift" prefWidth="80" />
                <TableColumn fx:id="totalColumn" text="Total (₹)" prefWidth="100" />
                <TableColumn fx:id="dateColumn" text="Date / Time" prefWidth="180" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_RIGHT">
            <Label fx:id="grandTotalLabel" styleClass="total-label" text="Grand Total: ₹0.00" />
        </HBox>
    </VBox>
</VBox>