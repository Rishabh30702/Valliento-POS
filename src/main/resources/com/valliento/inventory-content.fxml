<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.valliento.controller.InventoryController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <HBox spacing="15">
        <VBox styleClass="stat-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-title" text="Total Items" />
            <Label fx:id="totalItemsLabel" styleClass="stat-value" text="0" />
        </VBox>
        <VBox styleClass="stat-card" spacing="6" HBox.hgrow="ALWAYS">
            <Label styleClass="stat-title" text="Low Stock Items" />
            <Label fx:id="lowStockCountLabel" styleClass="stat-value" text="0" />
        </VBox>
    </HBox>

    <HBox spacing="15" VBox.vgrow="ALWAYS">

        <VBox spacing="10" styleClass="section-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="Stock Levels" />
            <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Product" prefWidth="180" />
                    <TableColumn fx:id="categoryColumn" text="Category" prefWidth="120" />
                    <TableColumn fx:id="stockColumn" text="Stock" prefWidth="70" />
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="90" />
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="section-card" prefWidth="280">
            <Label styleClass="section-title" text="Adjust Stock" />
            <Label text="Select a product from the table, enter a quantity, then Add or Remove." style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" wrapText="true" />

            <VBox spacing="4">
                <Label text="Quantity" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="adjustAmountField" promptText="e.g. 10" />
            </VBox>

            <HBox spacing="8">
                <Button styleClass="btn-save" text="Add Stock" onAction="#onAddStock" />
                <Button styleClass="btn-hold" text="Remove Stock" onAction="#onRemoveStock" />
            </HBox>
        </VBox>

    </HBox>
</VBox>