<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.valliento.controller.EmployeesController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <HBox spacing="15" VBox.vgrow="ALWAYS">
        <VBox spacing="10" styleClass="section-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="All Employees" />
            <TableView fx:id="employeesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Employee Name" prefWidth="170" />
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="130" />
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="120" />
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="90" />
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="section-card" prefWidth="280">
            <Label styleClass="section-title" text="Add / Edit Employee" />
            <Label text="Select a row to edit, or fill in blank fields to add new." style="-fx-font-size: 11px; -fx-text-fill: #6b7280;" wrapText="true" />

            <VBox spacing="4">
                <Label text="Name" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="nameField" promptText="e.g. Rohit Kumar" />
            </VBox>
            <VBox spacing="4">
                <Label text="Role" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="roleField" promptText="e.g. Cashier" />
            </VBox>
            <VBox spacing="4">
                <Label text="Phone" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="phoneField" promptText="e.g. 9876543211" />
            </VBox>
            <VBox spacing="4">
                <Label text="Status" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <ComboBox fx:id="statusCombo" maxWidth="Infinity" />
            </VBox>

            <HBox spacing="8">
                <Button styleClass="btn-save" text="Add" onAction="#onAddEmployee" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button styleClass="btn-hold" text="Update" onAction="#onUpdateEmployee" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
            <HBox spacing="8">
                <Button text="Delete" onAction="#onDeleteEmployee" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button text="Clear" onAction="#onClear" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
        </VBox>
    </HBox>
</VBox>