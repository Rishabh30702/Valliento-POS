<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.valliento.controller.SettingsController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>
    <VBox spacing="12" styleClass="section-card" maxWidth="500">
        <Label styleClass="section-title" text="General Settings" />

        <VBox spacing="4">
            <Label text="Business Name" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="businessNameField" promptText="e.g. Valliento Enterprises" />
        </VBox>
        <VBox spacing="4">
            <Label text="Address" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="addressField" promptText="e.g. 123, Main Street, Agra, Uttar Pradesh" />
        </VBox>
        <VBox spacing="4">
            <Label text="GSTIN" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="gstinField" promptText="e.g. 09ABCDE1234F1Z5" />
        </VBox>
        <VBox spacing="4">
            <Label text="Phone" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="phoneField" promptText="e.g. 9876543210" />
        </VBox>
        <VBox spacing="4">
            <Label text="Currency" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
            <TextField fx:id="currencyField" promptText="e.g. INR - ₹" />
        </VBox>

        <Button styleClass="btn-save" text="Save Settings" onAction="#onSaveSettings" />
    </VBox>
</VBox>