<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.valliento.controller.ExpensesController">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <VBox styleClass="stat-card" spacing="6" maxWidth="260">
        <Label styleClass="stat-title" text="Today's Total" />
        <Label fx:id="todaysTotalLabel" styleClass="stat-value" style="-fx-font-size: 18px;" text="Today's Expenses: ₹0.00" />
    </VBox>

    <HBox spacing="15" VBox.vgrow="ALWAYS">
        <VBox spacing="10" styleClass="section-card" HBox.hgrow="ALWAYS">
            <Label styleClass="section-title" text="All Expenses" />
            <TableView fx:id="expensesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="typeColumn" text="Expense Type" prefWidth="150" />
                    <TableColumn fx:id="amountColumn" text="Amount (₹)" prefWidth="110" />
                    <TableColumn fx:id="noteColumn" text="Note" prefWidth="200" />
                    <TableColumn fx:id="dateColumn" text="Date" prefWidth="150" />
                </columns>
            </TableView>
        </VBox>

        <VBox spacing="12" styleClass="section-card" prefWidth="280">
            <Label styleClass="section-title" text="Add Expense" />

            <VBox spacing="4">
                <Label text="Expense Type" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="typeField" promptText="e.g. Electricity" />
            </VBox>
            <VBox spacing="4">
                <Label text="Amount (₹)" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="amountField" promptText="e.g. 2450.00" />
            </VBox>
            <VBox spacing="4">
                <Label text="Note" style="-fx-font-size: 12px; -fx-font-weight: bold;" />
                <TextField fx:id="noteField" promptText="e.g. June Bill" />
            </VBox>

            <HBox spacing="8">
                <Button styleClass="btn-save" text="Add" onAction="#onAddExpense" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <Button text="Delete" onAction="#onDeleteExpense" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>
            <Button text="Clear" onAction="#onClear" maxWidth="Infinity" />
        </VBox>
    </HBox>
</VBox>